{
  "name": "gatsby-starter-default",
  "private": true,
  "description": "A simple starter to get up and developing quickly with Gatsby",
  "version": "0.1.0",
  "author": "Kyle Mathews <mathews.kyle@gmail.com>",
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "gatsby": "^5.14.1",
    "gatsby-plugin-google-adsense": "^1.1.3",
    "gatsby-plugin-google-gtag": "^5.15.0",
    "gatsby-plugin-image": "^3.14.0",
    "gatsby-plugin-manifest": "^5.14.0",
    "gatsby-plugin-react-helmet": "^6.14.0",
    "gatsby-plugin-sharp": "^5.14.0",
    "gatsby-plugin-typescript": "^5.14.0",
    "gatsby-remark-images": "^7.14.0",
    "gatsby-remark-prismjs": "^7.14.0",
    "gatsby-source-filesystem": "^5.14.0",
    "gatsby-transformer-remark": "^6.14.0",
    "gatsby-transformer-sharp": "^5.14.0",
    "googleapis": "^159.0.0",
    "lucide-react": "^0.544.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/react-helmet": "^6.1.11",
    "prettier": "^2.8.8",
    "remark": "^13.0.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "0BSD",
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop",
    "develop:preview": "BLOG_PREVIEW_DRAFTS=true gatsby develop --host 127.0.0.1",
    "test:publishing": "node --test tests/publishing.test.js",
    "test:views": "node --test tests/view-counts.test.js",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "start": "gatsby develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "node --test tests/*.test.js",
    "notion:check": "node scripts/notion-test-sync.js --check",
    "notion:sync": "node scripts/notion-test-sync.js",
    "develop:notion": "BLOG_NOTION_TEST=true BLOG_PREVIEW_DRAFTS=true gatsby develop --host 127.0.0.1",
    "build:notion-test": "BLOG_NOTION_TEST=true gatsby build",
    "test:notion": "node --test tests/notion-sync.test.js",
    "notion:pull": "node scripts/notion-cms.js",
    "notion:publish": "node scripts/notion-cms.js --publish",
    "develop:cms": "BLOG_NOTION_PREVIEW=true BLOG_PREVIEW_DRAFTS=true gatsby develop --host 127.0.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby-starter-default"
  },
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
  }
}
