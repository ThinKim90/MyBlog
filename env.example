# GoatCounter 설정
GC_SITE=your-site.goatcounter.com

# 선택: 조회수 캐시 TTL (초, Netlify Function)
# GC_CACHE_TTL=900
# GC_REQUEST_TIMEOUT_MS=1000
# GC_BATCH_TIMEOUT_MS=2500
# GC_REQUEST_CONCURRENCY=4

# 선택: 브라우저 조회수 캐시 TTL (밀리초, 기본 15분)
# GATSBY_VIEWCOUNT_CACHE_MS=900000
# netlify dev로 함수까지 실행할 때만 로컬 API 갱신 활성화
# GATSBY_VIEWCOUNT_DEV_API=true

# 사용법:
# 1. GoatCounter 사이트 코드를 GC_SITE에 입력
# 2. GATSBY_GC_SITE에도 동일 값 설정 (클라이언트 추적 스크립트용)
# 3. .env.local 파일로 복사하고 실제 값으로 교체
